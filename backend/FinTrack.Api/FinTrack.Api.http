@FinTrack.Api_HostAddress = http://localhost:5249

### Register
POST {{FinTrack.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Test User",
  "email": "test@example.com",
  "password": "Password123"
}

### Register with a short password (should return 400)
POST {{FinTrack.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Test User",
  "email": "short@example.com",
  "password": "12345"
}

### Login
POST {{FinTrack.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password123"
}

### Login with a wrong password (should return 401)
POST {{FinTrack.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "WrongPassword"
}

### Me (paste the token from the login response)
GET {{FinTrack.Api_HostAddress}}/api/auth/me
Authorization: Bearer PASTE_TOKEN_HERE